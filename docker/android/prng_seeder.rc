# Use the VM kernel's CSPRNG when no hardware entropy device is available.
# Create a separate device node so its ownership does not alter /dev/urandom.
on early-init
    exec -- /system/bin/toybox mknod -m 0400 /dev/hw_random c 1 9
    chown prng_seeder prng_seeder /dev/hw_random
    chmod 0400 /dev/hw_random
    start prng_seeder

service prng_seeder /system/bin/prng_seeder
    user prng_seeder
    group prng_seeder
    stdio_to_kmsg
    socket prng_seeder stream+listen 0666 prng_seeder prng_seeder

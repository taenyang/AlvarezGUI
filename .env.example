# Keep runtime data on a separate disk when needed.
ALVAREZ_DATA_DIR=./var

POSTGRES_DB=alvarez
POSTGRES_USER=alvarez
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

REDIS_HOST=127.0.0.1
REDIS_PORT=16379

MINIO_ROOT_USER=alvarez
MINIO_ROOT_PASSWORD=replace-with-another-local-secret
MINIO_HOST=127.0.0.1
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=alvarez

# Experiment console (control plane listens on all interfaces; password is required)
CONSOLE_PASSWORD=replace-with-console-password
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8600
NODE_ID=node-local
NODE_ADDRESS=
RUNTIME_BACKEND=fake
MODEL_BACKEND=fake_policy
MODEL_SERVICE_URL=http://127.0.0.1:18081
